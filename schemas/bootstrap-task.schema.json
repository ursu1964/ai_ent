{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ai-ent/bootstrap-task.schema.json",
  "title": "AI-Enterprise bootstrap task",
  "type": "object",
  "required": ["id", "stage", "title", "executor", "depends_on"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4}$"
    },
    "stage": {
      "type": "string",
      "pattern": "^B[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string"
    },
    "executor": {
      "type": "string",
      "enum": ["fake", "codex"]
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TASK-[0-9]{4}$"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "simulation": {
      "type": "object",
      "properties": {
        "result": {
          "type": "string",
          "enum": ["success", "failure", "timeout", "invalid_output", "scope_violation"]
        }
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
